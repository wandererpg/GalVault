filters:
  or:
  - review_status != ""
  - title_status != "confirmed"
  - completeness != "complete"
formulas: {}
properties:
  captured_at:
    displayName: 抓取时间
  completeness:
    displayName: 完整性
  confidence:
    displayName: 证据置信度
  entity_id:
    displayName: 实体 ID
  file.name:
    displayName: 文件
  review_status:
    displayName: 审核状态
  scope_review:
    displayName: 范围审核
  source:
    displayName: 来源
  source_ids:
    displayName: 来源 ID
  title_status:
    displayName: 中文标题状态
  title_zh:
    displayName: 中文标题
  warnings:
    displayName: 警告
views:
- filters:
    and:
    - review_status != ""
  groupBy:
    direction: ASC
    property: review_status
  name: 待审核队列
  order:
  - file.name
  - entity_id
  - source
  - review_status
  - confidence
  - warnings
  - captured_at
  type: table
- filters:
    and:
    - title_status != "confirmed"
  name: 中文标题审核
  order:
  - file.name
  - title_zh
  - title_status
  - source_ids
  type: table
- filters:
    and:
    - completeness != "complete"
  name: 来源完整性
  order:
  - file.name
  - source
  - completeness
  - scope_review
  - warnings
  type: table
